# Chép thành .env rồi đổi giá trị. .env KHÔNG được commit.

# ── PostgreSQL (docker compose up -d db) ──
POSTGRES_PASSWORD=doi-mat-khau-db
DB_PORT=5433
APP_PORT=4420
# Chạy app trên máy (uv) thì trỏ vào DB trong docker. Test tự dùng database <tên>_test (hoặc đặt TEST_DATABASE_URL).
DATABASE_URL=postgresql://thienla:doi-mat-khau-db@127.0.0.1:5433/thienla

# ── AI (Gemini) ──
LLM_API_KEY=
LLM_MODEL_NAME=gemini-3.5-flash-lite
APP_API_KEY=
# Tên "database" kiểu cũ — nay là schema trong Postgres (thienla.db → public, data/graph.db → graph)
THIENLA_DB=thienla.db
THIENLA_DATA=data
GRAPH_DATABASE=data/graph.db
AI_PIPELINE_DIR=data/ai-pipeline

# ── Bảo mật ──
# Mật khẩu màn đội rủi ro + khoá ký phiên (openssl rand -hex 32)
THIENLA_PASSWORD=
THIENLA_SECRET=
# Đặt 1 khi chạy sau reverse proxy (Caddy) để lấy IP thật + cookie Secure
THIENLA_BEHIND_PROXY=

# ── Demo ──
# Chế độ trình diễn: tự điền mật khẩu đội rủi ro + PIN khách demo. CHỈ bật khi demo.
DEMO_AUTOFILL=
DEMO_PIN=
# Bật mô phỏng hoạt động ngay khi server chạy + nhịp (giây)
SIM_AUTOSTART=
SIM_INTERVAL=3
